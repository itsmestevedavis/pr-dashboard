# Copy to .env and fill in values for your team. The .env file is gitignored.

# Default deploy environment shown on every My PRs card (e.g. dev-box).
# Leave empty to hide the Deploy button. Deploys push a preview/… branch; see
# ~/.config/pr-dashboard/deploy_targets.json for the repo → env → tracked
# workflow mapping (the workflow whose runs the Deployed tab shows).
DEPLOY_TARGET=dev-box

# URL where the dev box serves the deployed app (VPN), linked from the Deployed
# tab. Leave empty to hide the link.
# DEV_BOX_URL=https://your-github-login.internal.cognota.com

# Optional overrides (defaults shown).
# HOST=127.0.0.1
# PORT=8765
# CACHE_TTL=30

# Jira "Tickets" tab. Generate an API token at https://id.atlassian.com/manage-profile/security/api-tokens
# All three must be set for the tab to load tickets; otherwise it shows a config hint.
JIRA_SITE=your-org.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# Status names to show on the Tickets tab (comma-separated). Empty = show all.
# Set this from the Settings tab ("Fetch statuses from Jira"), or by hand here.
JIRA_STATUS_FILTER=

# Team tab. Teammates whose current work you want to see, by email (comma-
# separated). Resolved to Jira accounts (cached under ~/.config/pr-dashboard/);
# use the Settings "Resolve members" button to preview/refresh the mapping.
JIRA_TEAM=teammate1@example.com,teammate2@example.com

# Numeric board id the Team tab reads from (active sprint on Scrum boards; open
# board tickets on team-managed boards).
# Find it in the board URL: .../jira/software/projects/ABC/boards/123 -> 123.
# Jira creds + this + at least one JIRA_TEAM email are all required for the tab.
JIRA_BOARD_ID=

# Local repo paths the Cleanup tab scans for stale branches/worktrees
# (comma-separated, ~ expanded). The agent-clone cache is always scanned too.
CLEANUP_REPOS=~/git/your-repo

# Email treated as "you" for the Cleanup tab's "Only my branches" filter.
# Leave blank to use each repo's `git config user.email`.
CLEANUP_AUTHOR_EMAIL=

# Comma-separated logins of bot/machine *user* accounts whose comments should
# NOT mark a PR as "needs addressing" on the My PRs tab. GitHub App bots (e.g.
# codacy, dependabot) are filtered automatically; list here only bots that show
# up as normal users — e.g. an org service account. Matched case-insensitively.
BOT_LOGINS=CognotaBot

# Slack / Nudge

# Comma-separated GitHub logins to ping on Slack when nobody has reviewed
# your PR yet. The "Nudge" button uses this set in "fresh" mode.
# The "#Channel" button always tags these users in the team channel.
FRESH_REVIEWERS=teammate1,teammate2

# Slack channel ID (e.g. C01ABCDEF) where the "#Channel" button posts.
# Find it in Slack: right-click the channel → View channel details → copy ID at bottom.
TEAM_CHANNEL_ID=

# Optional: extra teams you can target from the Channel / Nudge dropdowns.
# JSON array — each entry needs a name, channel_id, and reviewers list.
# When set, both buttons gain a ▾ caret to pick a different team instead of the default.
# Example (all on one line):
# TEAMS=[{"name":"Platform","channel_id":"C0DEF456","reviewers":["charlie","diana"]}]
TEAMS=

# Maps GitHub logins to Slack member IDs (or @handles) for nudge/channel jobs.
# Lets the nudge workflow DM the right person without a Slack lookup.
# Find a member ID in Slack: open the person's profile → ⋯ → "Copy member ID".
# Format: github_id:slack_id (comma-separated), e.g. pratik12:U017JQ7D1B4,abirhalwa:U01D80JL22H
# An @handle also works in place of the U… member ID.
SLACK_IDS=
